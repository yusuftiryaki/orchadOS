# Command of unilidar.service (split on spaces; run in the ROS 2 environment).
# Installed once as /etc/orchados/unilidar.env. The node alone: upstream's
# launch.py also starts rviz2, which ros-base does not have.
UNILIDAR_CMD=ros2 run unitree_lidar_ros2 unitree_lidar_ros2_node --ros-args --params-file /etc/orchados/unilidar-params.yaml
