# Copy to .env.local. Local values come from `pnpm db:status` (run at the repo root).
# Never commit real keys.

# Supabase API URL and the public (anon / publishable) key. Safe to expose to the browser;
# every query is still limited by row level security.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional MapLibre style URL. Empty: OpenStreetMap raster tiles (development only).
NEXT_PUBLIC_MAP_STYLE_URL=

# Integration tests only (never read by the app). Empty: read from `supabase status`.
SUPABASE_SERVICE_ROLE_KEY=

# Office triangulation tool, development only: a folder with processed pipeline
# runs (`pnpm office:dev-data` prints it). Ignored by production builds unless
# LOCAL_PANORAMA_ALLOW_PRODUCTION=1 (browser tests only).
LOCAL_PANORAMA_DIR=
