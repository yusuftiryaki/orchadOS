# Copy to .env.local. Local values come from `pnpm db:status` (run at the repo root).
# Never commit real keys.

# Supabase API URL and the public (anon / publishable) key. Safe to expose to the browser;
# every query is still limited by row level security.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional MapLibre style URL. Empty: OpenStreetMap raster tiles (development only).
NEXT_PUBLIC_MAP_STYLE_URL=

# Integration tests only (never read by the app). Empty: read from `supabase status`.
SUPABASE_SERVICE_ROLE_KEY=

# Office triangulation tool, development only: a folder with processed pipeline
# runs (`pnpm office:dev-data` prints it). Ignored by production builds unless
# LOCAL_PANORAMA_ALLOW_PRODUCTION=1 (browser tests only).
LOCAL_PANORAMA_DIR=

# Public site and self-service sign-up (docs/musteri-yonetimi.md §13). All off by default.
# 1: /kayit and the sign-up links are shown; `/` completes a pending sign-up.
ORCHADOS_SIGNUP_ENABLED=
# 1: card payments are offered in the portal (İP12-D).
ORCHADOS_PAYMENTS_ENABLED=
# 1: the fake checkout page is used. Local, CI and the test project only; never in the pilot.
PAYMENT_FAKE_CHECKOUT=
# 1: robots.txt allows indexing and the sitemap lists the public pages. Off everywhere but production.
ORCHADOS_SITE_INDEXABLE=
# Public origin for robots.txt and the sitemap, e.g. https://orchados.com.tr
ORCHADOS_SITE_URL=
# Shared with the customer-signup Edge Function; lets it trust the client IP we send.
# Server only, never NEXT_PUBLIC. Local: signup-proxy-local (supabase/config.toml).
SIGNUP_PROXY_SECRET=
# Cloudflare Turnstile site key. Empty: no widget (local, CI). Required in the pilot.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
