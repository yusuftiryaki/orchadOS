# Copy to deploy/processing/machine.env (git-ignored). Names and sizes only, no
# secrets; credentials come from each CLI's own login. Values below are examples.

MACHINE_NAME=orchados-processing
WIN_MACHINE_NAME=orchados-studio
SSH_KEY=$HOME/.ssh/id_ed25519
# Office public IP for SSH (22) and RDP (3389), CIDR.
OFFICE_CIDR=203.0.113.10/32
# Monthly budget alert (provider currency, usually USD) and recipient.
BUDGET_AMOUNT=100
BUDGET_EMAIL=ops@example.com

# --- AWS ---------------------------------------------------------------------
AWS_REGION=eu-central-1
# g4dn.xlarge (T4), g6.xlarge (L4), g5.xlarge (A10G)
AWS_INSTANCE_TYPE=g4dn.xlarge
AWS_WIN_INSTANCE_TYPE=g4dn.xlarge
AWS_KEY_NAME=orchados
AWS_SECURITY_GROUP_ID=sg-0123456789abcdef0
AWS_WIN_SECURITY_GROUP_ID=sg-0123456789abcdef0
# Instance profile with read/write on the raw bucket (credentials stay off the disk).
AWS_INSTANCE_PROFILE=orchados-processing
AWS_DISK_GB=300

# --- Azure -------------------------------------------------------------------
AZ_RESOURCE_GROUP=orchados
AZ_LOCATION=westeurope
# Standard_NC4as_T4_v3 (T4). The A10 sizes (NVads_A10_v5) are GPU partitions that
# need the GRID driver: fine for Windows (extension), not for the Linux startup script.
AZ_SIZE=Standard_NC4as_T4_v3
AZ_WIN_SIZE=Standard_NV12ads_A10_v5
# Storage account of the raw container; the VM's managed identity gets blob access.
AZ_STORAGE_ACCOUNT=orchadosraw
AZ_DISK_GB=256
# Daily auto-shutdown (deallocates) as a second guard, UTC HHMM.
AZ_AUTO_SHUTDOWN_UTC=2000

# --- GCP ---------------------------------------------------------------------
GCP_PROJECT=orchados-pilot
GCP_ZONE=europe-west4-a
# g2-standard-4 includes one L4. For a T4: GCP_MACHINE_TYPE=n1-standard-8 GCP_ACCELERATOR=nvidia-tesla-t4
GCP_MACHINE_TYPE=g2-standard-4
GCP_ACCELERATOR=
GCP_WIN_MACHINE_TYPE=n1-standard-8
GCP_WIN_ACCELERATOR=nvidia-tesla-t4-vws
GCP_SERVICE_ACCOUNT=orchados-processing@orchados-pilot.iam.gserviceaccount.com
GCP_DISK_GB=300
GCP_BILLING_ACCOUNT=000000-000000-000000
