# Job environment for orchados-process on the processing machine.
# Copy to deploy/processing/process.env (never commit it: root .gitignore has .env.*,
# and this name is ignored too). `machine.sh <provider> run` copies it to the VM
# as /etc/orchados/process.env (root only).

# Raw store (services/ingest/README.md). Prefer the machine's role/identity for keys.
ORCHADOS_STORE_BACKEND=s3
ORCHADOS_STORE_PROVIDER=aws
ORCHADOS_STORE_BUCKET=orchados-raw-eu
ORCHADOS_STORE_REGION=eu-central-1
# AWS: instance profile, nothing here. R2/GCS (HMAC):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Azure: managed identity with ORCHADOS_STORE_ACCOUNT_URL=https://<account>.blob.core.windows.net

# Supabase, ops user (no service key)
SUPABASE_URL=
SUPABASE_ANON_KEY=
ORCHADOS_EMAIL=
ORCHADOS_PASSWORD=

# Optional
PROCESS_AI=0
# ANTHROPIC_API_KEY=
# PROCESS_BOUNDARY=auto
# LiDAR registration: auto = sessions with lidar/raw (Point-LIO needs the Docker socket
# and the front-end image on the machine: machine.sh <provider> lio-image).
# PROCESS_LIDAR=auto
# PROCESS_LIDAR_FRONTEND=point_lio
# PROCESS_UPLOAD_ONLY=preview,tree_crop,trajectory
